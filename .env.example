# Copy this file to .env and edit. .env is git-ignored — never commit it.

# paper = simulated trading (no keys) | testnet = Delta demo keys | live = real money
PROPDESK_MODE=paper

# Long random string. Generate one with:
#   python -c "import secrets; print(secrets.token_hex(32))"
PROPDESK_SECRET_KEY=change-this-to-a-long-random-string

# Admin login created on first start (username: admin)
PROPDESK_ADMIN_PASSWORD=change-me-admin

PROPDESK_NAME=PropDesk
PROPDESK_UPI_ID=yourname@upi
PROPDESK_UPI_NAME=PropDesk

# Optional: people who enter this code at signup skip approval
PROPDESK_INVITE_CODE=

PROPDESK_REGISTRATION_OPEN=1
PROPDESK_MAX_ACCOUNTS=2
PROPDESK_USD_INR=85
PORT=8000
