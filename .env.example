# Copy this file to .env and edit. .env is git-ignored — never commit it.

# paper = simulated trading (no keys) | testnet = Delta demo keys | live = real money
PROPDESK_MODE=paper

# Long random string. Generate one with:
#   python -c "import secrets; print(secrets.token_hex(32))"
PROPDESK_SECRET_KEY=change-this-to-a-long-random-string

# Admin login created on first start (username: admin)
PROPDESK_ADMIN_PASSWORD=change-me-admin

PROPDESK_NAME=PropDesk
PROPDESK_UPI_ID=yourname@upi
PROPDESK_UPI_NAME=PropDesk

# Email for login codes (optional). Leave SMTP_HOST empty and codes show on the
# admin dashboard + in this terminal instead. For Gmail: create an App Password at
# myaccount.google.com/apppasswords and use it as SMTP_PASS.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# Self-signup is off: you add traders from the admin panel
PROPDESK_REGISTRATION_OPEN=0
PROPDESK_MAX_ACCOUNTS=2
PROPDESK_USD_INR=85
PORT=8000
